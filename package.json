{
  "name": "janus-student-manager-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify:refactor": "node scripts/verify-refactor.cjs",
    "verify:auth": "node scripts/verify-auth.cjs",
    "verify:auth-ui": "node scripts/verify-auth-ui.cjs && node scripts/verify-auth-ui.cjs --disabled",
    "typecheck": "tsc -b",
    "test": "npm run verify:auth && npm run verify:auth-ui",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.95.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "4.1.11",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "26.1.0",
    "tailwindcss": "4.1.11",
    "typescript": "5.7.3",
    "vite": "6.0.7"
  }
}
